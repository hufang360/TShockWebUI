<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>WebUI</AssemblyName>
    <RootNamespace>WebUI</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0-rc.5</Version>
    <AssemblyTitle>WebUI</AssemblyTitle>
    <Product>WebUI</Product>
    <Description>TShockWebUI 的信使插件：在线授权登录 + 批量执行 / 只读信息 / 事件流 / 会话管理 / 网页发言 / 物资申请。</Description>
    <NoWarn>1701;1702;1591</NoWarn>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与目标服务端一致（TShock v6.2.1 / net9.0）。 -->
    <PackageReference Include="TShock" Version="6.2.1" />
  </ItemGroup>

</Project>
