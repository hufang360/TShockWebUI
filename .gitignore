# 依赖与构建产物
node_modules/
dist/
build/
*.local

# 开发用交叉编译产物（scripts/dev-container.sh）
.dev/

# 本机 Agent 技能（不入版本管理）
.agents/
.pi/

# 单文件构建时前端产物被拷入此处（server/main.go 用 //go:embed 内嵌），不入库
server/internal/webdist/*
!server/internal/webdist/.gitkeep

# 数据生成工具的构建产物（tools/gamedump）
tools/gamedump/bin/
tools/gamedump/obj/

# 信使插件（C#）构建产物
plugin/**/bin/
plugin/**/obj/

# 系统杂物
.DS_Store
